{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs", // Use "node16" for Node.js 16+ module resolution; "CommonJS" for Node.js < 16
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
